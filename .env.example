# Local preview works without keys. Never commit .env.
PORT=3001
APP_URL=http://localhost:3001
NODE_ENV=development
# Generate a long random secret before hosting. Used to sign sessions.
SESSION_SECRET=
# Merchant login; hosted mode requires both of these.
ADMIN_EMAIL=poorna@example.com
ADMIN_PASSWORD=
# Hosted deployment MUST use PostgreSQL. Local preview uses SQLite.
DATABASE_URL=
DEMO_MODE=true
# Choose huggingface (recommended if you already have HF access) or xai.
AI_PROVIDER=huggingface
HF_TOKEN=
# Choose an available model:provider supporting structured JSON output.
HF_MODEL=
# Alternative: direct xAI key and supported Grok model.
XAI_API_KEY=
XAI_MODEL=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=batchbridge-inquiries
# Change when a different inference endpoint is required in your Elastic project.
ELASTIC_INFERENCE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# Sandbox only. No production PayPal endpoint is supported.
MAX_AI_CALLS_PER_HOUR=30
