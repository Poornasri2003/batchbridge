{
  "name": "batchbridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/server.mjs && node --check web/app.js",
    "providers": "node --env-file-if-exists=.env scripts/check-providers.mjs",
    "test:postgres": "node --env-file-if-exists=.env scripts/check-postgres.mjs"
  },
  "dependencies": {
    "ag-grid-community": "^35.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
